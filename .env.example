NOTION_TOKEN=your_notion_token_here
DOCUMENT_INBOX_ID=your_document_inbox_database_id
APPROVAL_QUEUE_ID=your_approval_queue_database_id
RUN_LOG_ID=your_run_log_database_id
MAX_UPLOAD_SIZE_MB=10

# AI Configuration (Phase 4)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.6-flash

# OCR Configuration (Phase 4 Fallback)
MISTRAL_API_KEY=your_mistral_api_key_here

# Text quality thresholds (optional, defaults shown)
MIN_EMBEDDED_TEXT_LENGTH=50
MIN_TEXT_ALPHANUMERIC_RATIO=0.30

# SMTP Configuration (Phase 7)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com

EMAIL_FINANCE="finance@yourcompany.com"
EMAIL_IT="it@yourcompany.com"
EMAIL_LEGAL="legal@yourcompany.com"
EMAIL_HR="hr@yourcompany.com"
EMAIL_OPERATIONS="operations@yourcompany.com"
EMAIL_DEFAULT="admin@yourcompany.com"
